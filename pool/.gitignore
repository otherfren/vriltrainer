# Written by poolctl: the normalised PNGs and their provenance. Build artefacts — the manifest
# names them and `poolctl import` recreates them from the sources in images/.
normalised/
catalogue.json

# Whatever a source arrived as before it was converted. Keep them if you like; nothing reads them.
originals/

# The copy `--pool` names, which is whichever v<N>.json is current. A duplicate that goes stale the
# moment a version is cut; `v*.json` beside it is the permanent record and stays tracked.
manifest.json
