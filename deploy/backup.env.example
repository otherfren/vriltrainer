# Copy to /home/bob/vriltrainer/backup.env and fill in. Sourced by backup.sh.
# Without it the job still runs and keeps a verified local copy — off-site is the
# only part that needs anything from here.
#
# chmod 600: it holds the store's credentials.

# --- Off-site copy (optional) -------------------------------------------------
# Any S3-compatible endpoint. The blob is already encrypted with the passphrase
# in .backup-pass before it leaves the box, so the store is untrusted by
# construction — it holds ciphertext and a filename, and the filename says only
# when the snapshot was taken and how many entries it held.
#
#S3_ENDPOINT=https://s3.example.com
#S3_BUCKET=vriltrainer-audit
#S3_REGION=us-east-1
#S3_KEY_ID=
#S3_SECRET=

# --- Paths (optional) ---------------------------------------------------------
# Defaults are the live layout; set these only to run the job somewhere else.
#
#VRIL_ROOT=/home/bob/vriltrainer
#VRIL_DB=/home/bob/vriltrainer/shared/vriltrainer.db
#VRIL_BACKUP_DIR=/home/bob/vriltrainer/backups
#VRIL_BACKUP_PASSFILE=/home/bob/vriltrainer/.backup-pass
#VRIL_VERIFY_LOG=/home/bob/vriltrainer/shared/verify_log

# --- Retention (optional) -----------------------------------------------------
# Every snapshot inside KEEP_ALL_DAYS; then one per day up to KEEP_DAILY_DAYS;
# then one per month, kept forever.
#
#VRIL_KEEP_ALL_DAYS=7
#VRIL_KEEP_DAILY_DAYS=90
